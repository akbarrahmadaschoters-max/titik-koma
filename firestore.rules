rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMatchMember(memberUserIds) {
      return isAuthenticated() && request.auth.uid in memberUserIds;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Assessments Collection (STRICT PRIVACY: Only owner can read/write)
    match /assessments/{assessmentId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // 3. Journal Entries Collection (STRICT PRIVACY: Never readable by other users!)
    match /journal_entries/{entryId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // 4. Archetypes Collection
    match /archetypes/{archetypeId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // 5. Goals Collection
    match /goals/{goalId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // 6. Seasons Collection
    match /seasons/{seasonId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // 7. Habits Collection & Habit Logs
    match /habits/{habitId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }
    match /habit_logs/{logId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // 8. Quests Collection
    match /quests/{questId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // 9. Tracks Collection (Public read for authenticated users)
    match /tracks/{trackId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admin via Admin SDK
    }

    // 10. Matches Collection (Only matched members can read)
    match /matches/{matchId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberUserIds;
      allow write: if false; // Only created via Server / Cloud Function matching engine
    }

    // 11. Exchange Sessions & Messages
    match /exchange_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }
    match /exchange_messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // 12. Moderation Reports
    match /moderation_reports/{reportId} {
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.reporterId;
      allow read, update: if false; // Admin SDK only
    }

    // 13. CPS Scores
    match /cps_scores/{cpsId} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow write: if false; // Computed via Server / Cron only
    }
  }
}
